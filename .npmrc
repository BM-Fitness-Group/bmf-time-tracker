; vite-plugin-pwa@1.2.0 has a peer-dep range of vite@^3–^7 and hasn't been
; published for Vite 8 yet. Our package.json pins vite@^8.0.9, so npm's default
; strict resolution fails on "npm install" (including on Vercel). This flag
; reverts to npm@6-style resolution which ignores peer-dep conflicts — safe
; here because the plugin works fine with Vite 8 in practice, just isn't
; officially declared.
legacy-peer-deps=true
